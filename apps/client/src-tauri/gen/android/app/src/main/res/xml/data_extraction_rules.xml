<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone: the settings file holds
     the tokens that prove this device to the host, and a copy of them on
     another phone, or in a cloud backup, would be a copy of that trust. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
